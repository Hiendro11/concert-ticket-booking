    {
      "name": "02 - Customer Bookings",
      "item": [
        {
          "name": "Create Booking with GEEK10",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{customerUserId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-booking-001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concertId\": \"{{concertId}}\",\n  \"ticketCategoryId\": \"{{vipCategoryId}}\",\n  \"quantity\": 2,\n  \"voucherCode\": \"GEEK10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Booking id exists\", () => pm.expect(body.id).to.be.a(\"string\"));",
                  "pm.environment.set(\"bookingId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry Same Idempotency Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{customerUserId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-booking-001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concertId\": \"{{concertId}}\",\n  \"ticketCategoryId\": \"{{vipCategoryId}}\",\n  \"quantity\": 2,\n  \"voucherCode\": \"GEEK10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Retry succeeds\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Same logical booking\", () => pm.expect(body.id).to.eql(pm.environment.get(\"bookingId\")));"
                ]
              }
            }
          ]
        },
