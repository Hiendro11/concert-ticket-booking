generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  OPERATOR
}

enum ConcertStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

model User {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email     String   @unique(map: "uq_users_email") @db.VarChar(255)
  name      String   @db.VarChar(120)
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  bookings           Booking[]
  idempotencyKeys    IdempotencyKey[]
  voucherRedemptions VoucherRedemption[]
  statusChanges      BookingStatusHistory[] @relation("ChangedByUser")

  @@map("users")
}

model Concert {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name        String        @db.VarChar(200)
  venue       String        @db.VarChar(255)
  description String?       @db.Text
  startsAt    DateTime      @map("starts_at") @db.DateTime(3)
  status      ConcertStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  ticketCategories TicketCategory[]
  bookings         Booking[]

  @@index([status, startsAt, id], map: "idx_concerts_status_starts_at")
  @@map("concerts")
}

model TicketCategory {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  concertId         BigInt   @map("concert_id") @db.UnsignedBigInt
  name              String   @db.VarChar(100)
  price             Decimal  @db.Decimal(15, 2)
  totalQuantity     Int      @map("total_quantity") @db.UnsignedInt
  availableQuantity Int      @map("available_quantity") @db.UnsignedInt
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  concert  Concert   @relation(fields: [concertId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@unique([concertId, name], map: "uq_ticket_categories_concert_name")
  @@map("ticket_categories")
}

model Booking {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt        @map("user_id") @db.UnsignedBigInt
  concertId        BigInt        @map("concert_id") @db.UnsignedBigInt
  ticketCategoryId BigInt        @map("ticket_category_id") @db.UnsignedBigInt
  quantity         Int           @db.UnsignedInt
  unitPrice        Decimal       @map("unit_price") @db.Decimal(15, 2)
  subtotal         Decimal       @db.Decimal(15, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(15, 2)
  status           BookingStatus @default(PENDING_PAYMENT)
  expiresAt        DateTime?     @map("expires_at") @db.DateTime(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  concert        Concert        @relation(fields: [concertId], references: [id], onDelete: Restrict)
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Restrict)

  voucherRedemption VoucherRedemption?
  idempotencyKey    IdempotencyKey?
  statusHistory     BookingStatusHistory[]

  @@index([userId, createdAt, id], map: "idx_bookings_user_created")
  @@index([status, createdAt, id], map: "idx_bookings_status_created")
  @@index([concertId, createdAt, id], map: "idx_bookings_concert_created")
  @@map("bookings")
}

model Voucher {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  code          String              @unique(map: "uq_vouchers_code") @db.VarChar(64)
  discountType  VoucherDiscountType @map("discount_type")
  discountValue Decimal             @map("discount_value") @db.Decimal(15, 2)
  usageLimit    Int                 @map("usage_limit") @db.UnsignedInt
  usedCount     Int                 @default(0) @map("used_count") @db.UnsignedInt
  status        VoucherStatus       @default(ACTIVE)
  startsAt      DateTime            @map("starts_at") @db.DateTime(3)
  endsAt        DateTime            @map("ends_at") @db.DateTime(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  redemptions VoucherRedemption[]

  @@map("vouchers")
}

model VoucherRedemption {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  voucherId      BigInt   @map("voucher_id") @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  bookingId      BigInt   @unique(map: "uq_voucher_redemptions_booking") @map("booking_id") @db.UnsignedBigInt
  discountAmount Decimal  @map("discount_amount") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([voucherId, userId], map: "uq_voucher_redemptions_voucher_user")
  @@map("voucher_redemptions")
}

model IdempotencyKey {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt            @map("user_id") @db.UnsignedBigInt
  idempotencyKey String            @map("idempotency_key") @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  bookingId      BigInt?           @unique(map: "uq_idempotency_booking") @map("booking_id") @db.UnsignedBigInt
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey], map: "uq_idempotency_user_key")
  @@map("idempotency_keys")
}

model BookingStatusHistory {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId       BigInt         @map("booking_id") @db.UnsignedBigInt
  fromStatus      BookingStatus? @map("from_status")
  toStatus        BookingStatus  @map("to_status")
  changedByUserId BigInt?        @map("changed_by_user_id") @db.UnsignedBigInt
  reason          String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  changedBy User?   @relation("ChangedByUser", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt, id], map: "idx_booking_status_history_booking_created")
  @@map("booking_status_history")
}
